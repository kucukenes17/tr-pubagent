{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# TR-PubAgent — Kaggle Phi-4 deneyleri\n",
    "Bu defter dondurulmuş `Unguarded Agent v1` deneyini 20 geliştirme görevinde çalıştırır. Kaggle ayarlarından **GPU** ve **Internet on** seçilmelidir. Gerçek kişisel veri kullanılmaz."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os, subprocess, sys\n",
    "from pathlib import Path\n",
    "import torch\n",
    "\n",
    "assert torch.cuda.is_available(), 'Kaggle Settings > Accelerator bölümünden GPU seçin.'\n",
    "print('Python:', sys.version)\n",
    "print('PyTorch:', torch.__version__)\n",
    "print('GPU sayısı:', torch.cuda.device_count())\n",
    "for index in range(torch.cuda.device_count()):\n",
    "    print(index, torch.cuda.get_device_name(index))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "REPO_URL = 'https://github.com/kucukenes17/tr-pubagent.git'\n",
    "EXPERIMENT_COMMIT = '80ef8edb8749993c654c379856725350c0b4b9cc'\n",
    "REPO = Path('/kaggle/working/tr-pubagent')\n",
    "\n",
    "if not REPO.exists():\n",
    "    subprocess.run(['git', 'clone', REPO_URL, str(REPO)], check=True)\n",
    "else:\n",
    "    subprocess.run(['git', 'fetch', 'origin'], cwd=REPO, check=True)\n",
    "subprocess.run(['git', 'checkout', '--detach', EXPERIMENT_COMMIT], cwd=REPO, check=True)\n",
    "os.chdir(REPO)\n",
    "print('Deney commit\'i:', subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "subprocess.run([sys.executable, '-m', 'pip', 'install', '-q', '-r', 'backend/requirements.txt'], check=True)\n",
    "subprocess.run([sys.executable, '-m', 'pip', 'install', '-q', '-r', 'ml/requirements-colab.txt'], check=True)\n",
    "subprocess.run([sys.executable, '-m', 'pytest', 'backend/tests', '--basetemp=/tmp/tr-pubagent-tests', '-q'], check=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "RESULTS_DIR = Path('/kaggle/working/tr-pubagent-results')\n",
    "RESULTS_DIR.mkdir(parents=True, exist_ok=True)\n",
    "subprocess.run([sys.executable, 'benchmark/export_tasks.py', '--output', str(RESULTS_DIR / 'tr_pubbench_tasks.jsonl')], check=True)\n",
    "subprocess.run([sys.executable, 'benchmark/run_scripted.py', '--split', 'development', '--output', str(RESULTS_DIR / 'scripted_results.jsonl')], check=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Dondurulmuş Phi-4 Unguarded v1 — 20 görev\n",
    "Bu hücre `microsoft/Phi-4-mini-instruct` modelini 4-bit NF4 olarak yükler. Her görevden sonra JSONL dosyası güncellenir."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "PHI_RESULTS = RESULTS_DIR / 'phi4_unguarded_dev_v1.jsonl'\n",
    "subprocess.run([\n",
    "    sys.executable, 'benchmark/run_phi4.py',\n",
    "    '--split', 'development', '--limit', '20', '--seed', '0',\n",
    "    '--output', str(PHI_RESULTS),\n",
    "], check=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "from collections import Counter\n",
    "\n",
    "rows = [json.loads(line) for line in PHI_RESULTS.read_text(encoding='utf-8').splitlines() if line.strip()]\n",
    "summary = {\n",
    "    'runs': len(rows),\n",
    "    'successes': sum(bool(row['task_success']) for row in rows),\n",
    "    'task_success_rate': sum(bool(row['task_success']) for row in rows) / len(rows),\n",
    "    'invalid_actions': sum(bool(row['invalid_action']) for row in rows),\n",
    "    'terminations': dict(Counter(row['termination'] for row in rows)),\n",
    "    'violations': dict(Counter(label for row in rows for label in row['violations'])),\n",
    "    'mean_safety_score': sum(row['safety_score'] for row in rows) / len(rows),\n",
    "    'mean_steps': sum(row['steps'] for row in rows) / len(rows),\n",
    "    'generated_tokens': sum(row['generated_tokens'] for row in rows),\n",
    "    'latency_seconds': sum(row['latency_seconds'] for row in rows),\n",
    "    'git_commits': dict(Counter(row['git_commit'] for row in rows)),\n",
    "    'model_revisions': dict(Counter(str(row['model_revision']) for row in rows)),\n",
    "    'prompt_versions': dict(Counter(row['prompt_version'] for row in rows)),\n",
    "}\n",
    "(RESULTS_DIR / 'phi4_unguarded_dev_v1_summary.json').write_text(json.dumps(summary, ensure_ascii=False, indent=2), encoding='utf-8')\n",
    "print(json.dumps(summary, ensure_ascii=False, indent=2))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import shutil\n",
    "for database_name in ('scripted_runs.db', 'phi4_unguarded_runs.db'):\n",
    "    source = REPO / 'outputs' / database_name\n",
    "    if source.exists():\n",
    "        shutil.copy2(source, RESULTS_DIR / database_name)\n",
    "environment = {\n",
    "    'python': sys.version,\n",
    "    'torch': torch.__version__,\n",
    "    'cuda': torch.version.cuda,\n",
    "    'gpus': [torch.cuda.get_device_name(i) for i in range(torch.cuda.device_count())],\n",
    "}\n",
    "(RESULTS_DIR / 'environment.json').write_text(json.dumps(environment, indent=2), encoding='utf-8')\n",
    "archive = shutil.make_archive('/kaggle/working/tr-pubagent-kaggle-results', 'zip', root_dir=RESULTS_DIR)\n",
    "print('İndirilecek arşiv:', archive)\n",
    "print('Boyut (MiB):', round(Path(archive).stat().st_size / 1024 / 1024, 2))"
   ]
  }
 ],
